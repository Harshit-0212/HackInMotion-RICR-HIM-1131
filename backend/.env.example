# Server
PORT=3001
CLIENT_ORIGIN=https://your-frontend-domain.com

# Auth
JWT_SECRET=change-this-to-a-long-random-string

# Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# YouTube Data API v3 (https://console.cloud.google.com/apis/credentials) - optional,
# powers video suggestions in the AI Tutor chat. Leave blank to disable.
YOUTUBE_API_KEY=

# MongoDB - stores user accounts
MONGODB_URI=mongodb://localhost:27017/
MONGODB_DB_NAME=nova

# Google OAuth (https://console.cloud.google.com/apis/credentials) - "OAuth client ID",
# type "Web application". Add http://localhost:5173 as an authorized JavaScript origin.
# This is the public Client ID (ends in .apps.googleusercontent.com), not a secret.
GOOGLE_CLIENT_ID=



# Code Execution Provider (onlinecompiler.io)
CODE_EXECUTION_API_KEY=

# 32-byte master encryption key for user Gemini keys (AES-256-GCM v2)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GEMINI_ENCRYPTION_KEY=
